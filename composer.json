{
    "name": "siensis/kpskeletor",
    "description": "kp Web Skeletor: modular, themeable CodeIgniter 4 application skeleton (modules, Shield auth with 2FA, central RBAC, kpcrudy back office, kpapy JSON API).",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "codeigniter4",
        "skeleton",
        "modular",
        "rbac",
        "shield"
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "codeigniter4/framework": "^4.7",
        "codeigniter4/settings": "^2.4",
        "codeigniter4/shield": "^1.4",
        "codeigniter4/translations": "^4.7",
        "siensis/kpapy": "^1.0",
        "siensis/kpcrudy": "^1.0"
    },
    "require-dev": {
        "codeigniter/phpstan-codeigniter": "^2.2",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-mysqli": "MariaDB/MySQL database driver",
        "ext-sqlite3": "SQLite driver (tests and small installs)"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Modules\\": "modules/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "analyse": "Run PHPStan (level 6)",
        "cs": "Check coding style (dry run)",
        "cs-fix": "Fix coding style"
    }
}
