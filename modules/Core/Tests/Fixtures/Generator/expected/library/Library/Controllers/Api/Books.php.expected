<?php

declare(strict_types=1);

namespace Modules\Library\Controllers\Api;

use CodeIgniter\Controller;
use CodeIgniter\HTTP\ResponseInterface;
use Kpapy\Auth\Context;
use Kpapy\Resource;
use Modules\Core\Content\ContentTranslations;
use Modules\Core\Permissions\Authorization;

/**
 * API resource `api/v1/library/books` (kpapy): the books with the same permissions as their CRUD
 * (`setResource('library-books')`; a token's scopes are those permission names). Generated by the code generator
 * (docs/devtools.md).
 *
 * Record rule as in the CRUD: without `library-books.all`, only the rows whose `created_by` is the token's user (also enforced on writes).
 */
final class Books extends Controller
{
    public function index(): ResponseInterface
    {
        $user = Context::user();

        $resource = (new Resource())
            ->setTable('library_books')
            ->setResource('library-books')
            ->setTranslations('library_books_translations', 'library_book_id', 'locale', ['title', 'summary'], ContentTranslations::codes(), ContentTranslations::apiOptions())
            ->fieldType('status', 'enum', ['options' => ['available' => 'available', 'lent' => 'lent', 'lost' => 'lost']])
            ->fieldType('price', 'decimal')
            ->fieldType('published_on', 'date')
            ->fieldType('available', 'bool')
            ->fields([
                'id',
                'title',
                'summary',
                'isbn',
                'status',
                'price',
                'shelf_id',
                'published_on',
                'available',
                'cover',
                'notes',
                'created_by',
                'created_at',
                'updated_at',
            ])
            ->listFields(['id', 'title', 'isbn', 'status', 'shelf_id', 'available'])
            ->writeFields(['title', 'summary', 'isbn', 'status', 'price', 'shelf_id', 'published_on', 'available', 'notes'])
            ->requiredFields(['isbn', 'shelf_id'])
            ->filters(['status', 'shelf_id', 'available'])
            ->searchFields(['title', 'isbn'])
            ->defaultOrder('id', 'desc')
            ->describe(lang('Library.books.api.summary'), lang('Library.books.api.description'));

        if ($user === null || ! Authorization::for($user)->can('library-books.all')) {
            $resource->where('created_by', $user === null ? 0 : (int) $user->id);
        }

        if ($user === null || ! Authorization::for($user)->can('library-books.prices')) {
            $resource->hideFields(['price']);
        }

        return $resource->render();
    }
}
