    public function load(DemoData $demo): void
    {
        $this->seedLibraryShelves($demo);
        $this->seedLibraryBooks($demo);
    }

    /**
     * 3 demo rows of `library_shelves` (made with Faker when the code was generated).
     */
    private function seedLibraryShelves(DemoData $demo): void
    {
        $rows = [
            ['code' => 'cum-eos-repellat-ill', 'room' => 'El Páez'],
            ['code' => 'rerum-et-iste-2', 'room' => 'L\' Alemán del Puerto'],
            ['code' => 'iste-perspiciatis-ip', 'room' => 'Balderas del Bages'],
        ];

        foreach ($rows as $row) {
            $demo->insert('library_shelves', $row);
        }
    }

