<?php

declare(strict_types=1);

namespace Modules\Library\Controllers;

use CodeIgniter\HTTP\ResponseInterface;
use Modules\Core\Controllers\BackendController;

/**
 * Back office of the shelves, `<back office>/library/shelves` (resource `library-shelves`, table
 * `library_shelves`). Generated by the code generator (docs/devtools.md); adapt it freely within the
 * rules of `CLAUDE.md`. Writes, operations and exports are logged by the Core (`AuditedCrud`).
 */
final class Shelves extends BackendController
{
    public function index(): ResponseInterface|string
    {
        $crud = $this->crud('library-shelves');

        $crud->setTable('library_shelves')
            ->setSubject(lang('Library.shelves.singular'), lang('Library.shelves.plural'))
            ->columns(['code', 'room'])
            ->fields(['code', 'room'])
            ->showFields(['code', 'room', 'created_at', 'updated_at'])
            ->exportColumns(['code', 'room'])
            ->searchFields(['code', 'room'])
            ->setRules([
                'code' => 'required|max_length[20]|is_unique[library_shelves.code,id,{id}]',
                'room' => 'permit_empty|max_length[80]',
            ])
            ->displayAs(self::labels())
            ->defaultOrder('id', 'desc');

        // Operations the resource does not declare (manifest `except`).
        $crud->readOnly();

        return $this->renderCrud($crud);
    }

    /**
     * @return array<string, string>
     */
    private static function labels(): array
    {
        $labels = [];

        foreach (['code', 'room', 'created_at', 'updated_at'] as $field) {
            $labels[$field] = lang('Library.shelves.fields.' . $field);
        }

        return $labels;
    }
}
