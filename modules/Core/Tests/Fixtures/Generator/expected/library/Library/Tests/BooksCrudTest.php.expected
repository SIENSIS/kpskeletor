<?php

declare(strict_types=1);

namespace Modules\Library\Tests;

use CodeIgniter\I18n\Time;
use CodeIgniter\Shield\Entities\User;
use Kpcrudy\Crud;
use Modules\Auth\Tests\AuthTestCase;
use Modules\Core\Permissions\CrudPermissions;

/**
 * The CRUD `library-books` (`<back office>/library/books`, table `library_books`): its permissions,
 * forged posts and its own rules. Generated by the code generator (docs/devtools.md): add the
 * tests of the rules you write.
 *
 * @internal
 */
final class BooksCrudTest extends AuthTestCase
{
    private const LIST = 'library/books';

    protected function setUp(): void
    {
        parent::setUp();
        CrudPermissions::reset();
    }

    public function testTheListNeedsItsPermission(): void
    {
        $this->send('GET', backend_path(self::LIST))->assertRedirectTo(site_url('login'));

        $this->signIn();
        $this->send('GET', backend_path(self::LIST))->assertStatus(403);
    }

    public function testAUserWithTheListPermissionSeesTheRows(): void
    {
        $this->signIn('library-books.list', 'library-books.show');
        $this->row();

        $this->send('GET', backend_path(self::LIST))->assertOK();
    }

    public function testForgedPostsWithoutPermissionChangeNothing(): void
    {
        $this->signIn('library-books.list', 'library-books.show');
        $id   = $this->row();
        $rows = $this->db->table('library_books')->countAllResults();
        $list = backend_path(self::LIST);

        $this->assertCrudRefused($this->send('POST', $list . '/add', $this->form()), $list, 'add');
        $this->assertCrudRefused($this->send('POST', $list . '/edit/' . $this->code($id), $this->form()), $list, 'edit');
        $this->assertCrudRefused($this->send('POST', $list . '/delete/' . $this->code($id)), $list, 'delete');
        $this->assertCrudRefused($this->send('POST', $list . '/lend/' . $this->code($id)), $list, 'lend');
        $this->assertCrudRefused($this->send('POST', $list . '/writeoff/' . $this->code($id)), $list, 'writeoff');

        $this->assertSame($rows, $this->db->table('library_books')->countAllResults());
    }

    public function testAUserWithTheAddPermissionAddsARow(): void
    {
        $this->signIn('library-books.list', 'library-books.add');
        $rows = $this->db->table('library_books')->countAllResults();

        $this->send('POST', backend_path(self::LIST) . '/add', $this->form())->assertRedirect();

        $this->assertSame($rows + 1, $this->db->table('library_books')->countAllResults());
    }

    public function testWithoutAllAUserChangesOnlyTheirOwnRows(): void
    {
        $this->signIn('library-books.list', 'library-books.show', 'library-books.edit');
        $other = $this->row(['created_by' => (int) $this->createUser('other@example.com')->id]);

        // A row outside the user's scope is "not found".
        $this->send('POST', backend_path(self::LIST) . '/delete/' . $this->code($other));

        $this->assertNotNull($this->db->table('library_books')->where('id', $other)->get()->getRowArray());
    }

    public function testThePriceFieldNeedsItsPermission(): void
    {
        $this->signIn('library-books.list', 'library-books.show', 'library-books.add');
        $body = (string) $this->send('GET', backend_path(self::LIST) . '/add')->response()->getBody();

        $this->assertStringNotContainsString('name="price"', $body);
    }

    public function testTheWriteoffOperationNeedsReauthentication(): void
    {
        $this->signIn('library-books.list', 'library-books.writeoff');
        $id = $this->row();
        Time::setTestNow(Time::now()->addMinutes(16));

        try {
            $response = $this->send('POST', backend_path(self::LIST) . '/writeoff/' . $this->code($id));
        } finally {
            Time::setTestNow();
        }

        $response->assertRedirect();
        $this->assertStringContainsString('reauth', $response->response()->getHeaderLine('Location'));
    }

    /**
     * A signed-in user with these individual permissions only: no group, so the default grants of
     * the groups do not count.
     */
    private function signIn(string ...$permissions): User
    {
        $user = $this->createUser('ana@example.com');
        $user->syncGroups();

        if ($permissions !== []) {
            $user->addPermission(...$permissions);
        }

        $this->login('ana@example.com');

        return $user;
    }

    /**
     * A row written directly (no CRUD) and owned by the signed-in user, returning its id.
     *
     * @param array<string, mixed> $values
     */
    private function row(array $values = []): int
    {
        $this->db->table('library_books')->insert($values + ['created_by' => auth()->id()] + ['isbn' => 'dolor-molestiae-maxi', 'shelf_id' => $this->parentId('library_shelves')]);

        return (int) $this->db->insertID();
    }

    /**
     * The values of the add/edit form.
     *
     * @return array<string, mixed>
     */
    private function form(): array
    {
        return [
            'isbn' => 'dolor-molestiae-maxi',
            'status' => 'available',
            'price' => '429.82',
            'shelf_id' => (string) $this->parentId('library_shelves'),
            'published_on' => '2026-07-01',
            'available' => '0',
            'cover' => '',
            'notes' => '<p>Text</p>',
            'kp_tr' => [
                'ca' => ['title' => 'Rerum nam vero veniam ratione', 'summary' => '<p>Text</p>'],
                'es' => ['title' => 'Rerum nam vero veniam ratione', 'summary' => '<p>Text</p>'],
                'en' => ['title' => 'Rerum nam vero veniam ratione', 'summary' => '<p>Text</p>'],
            ],
        ];
    }

    private function code(int $id): string
    {
        return Crud::maskId($id, 'library_books');
    }

    /** @var array<string, int> rows made by parentId() in this test */
    private array $parents = [];

    /**
     * A row of a table a required foreign key points at (made once per test).
     */
    private function parentId(string $table): int
    {
        $rows = ['library_shelves' => ['code' => 'ut-temporibus-quis-a']];

        if (! isset($this->parents[$table]) && isset($rows[$table])) {
            $this->db->table($table)->insert($rows[$table]);
            $this->parents[$table] = (int) $this->db->insertID();
        }

        if (! isset($this->parents[$table])) {
            $row                    = $this->db->table($table)->select('id')->get(1)->getRowArray();
            $this->parents[$table] = is_array($row) ? (int) $row['id'] : 1;
        }

        return $this->parents[$table];
    }
}
