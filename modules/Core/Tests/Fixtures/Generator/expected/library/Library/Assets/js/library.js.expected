/**
 * Example component of the Library module: `data-component="library/library"` in
 * Views/index.php. core/components.js imports this file on demand (import map: `library/…` =
 * modules/Library/Assets/js/…) and calls mount(element, options). Build the DOM with
 * textContent/createElement, never innerHTML with data; import other modules with bare
 * specifiers (`core/http.js`, `library/…`), never relative paths.
 */
export function mount(root, options) {
    root.textContent = String(options.message || '');
    root.hidden = false;
}
