<?php

declare(strict_types=1);

namespace Modules\Library\Controllers;

use Modules\Core\Controllers\BackendController;

/**
 * Main back-office screen of the Library module (resource "main").
 */
final class Home extends BackendController
{
    public function index(): string
    {
        return $this->render('Modules\Library\Views\index', [
            'title' => lang('Library.title'),
        ]);
    }
}
