<?php

declare(strict_types=1);

namespace Modules\Library\Controllers;

use CodeIgniter\HTTP\ResponseInterface;
use Modules\Core\Content\ContentTranslations;
use Modules\Core\Controllers\BackendController;
use Modules\Core\Frontend\RichTextEditor;
use Modules\Core\Security\HtmlSanitizer;
use Modules\Library\Storage\BooksUploads;

/**
 * Back office of the books, `<back office>/library/books` (resource `library-books`, table
 * `library_books`). Generated by the code generator (docs/devtools.md); adapt it freely within the
 * rules of `CLAUDE.md`. Writes, operations and exports are logged by the Core (`AuditedCrud`).
 *
 * - Rich text (summary, notes): the Core editor, sanitised with `HtmlSanitizer` before kpcrudy reads the form.
 * - Translated columns (title, summary) in `library_books_translations` (`setTranslations()`, the site's languages).
 * - Record rule: users without `library-books.all` see and change only their rows (`created_by`).
 */
final class Books extends BackendController
{
    public function index(): ResponseInterface|string
    {
        $this->sanitizePosted();

        $crud = $this->crud('library-books');
        $me   = (int) auth()->id();

        $crud->setTable('library_books')
            ->setSubject(lang('Library.books.singular'), lang('Library.books.plural'))
            ->setTranslations('library_books_translations', 'library_book_id', 'locale', ['title', 'summary'], ContentTranslations::locales(), ContentTranslations::crudOptions([
                'types' => ['title' => 'text', 'summary' => 'textarea'],
                'rules' => ['title' => 'required|max_length[190]', 'summary' => 'permit_empty|max_length[65000]'],
                'attrs' => ['summary' => RichTextEditor::attrs(RichTextEditor::images('library'))],
            ]))
            ->fieldType('status', 'select', ['options' => self::options('status', ['available', 'lent', 'lost'])])
            ->fieldType('price', 'decimal')
            ->setRelation('shelf_id', 'library_shelves', 'code')
            ->fieldType('published_on', 'date')
            ->fieldType('available', 'boolean')
            ->callbackField('cover', static fn ($value, ?array $row, array $field): string => BooksUploads::renderPicker('cover', $value, $field))
            ->fieldType('notes', 'textarea', ['attrs' => RichTextEditor::attrs(RichTextEditor::images('library'))])
            ->setRelation('created_by', 'users', 'username')
            ->columns(['title', 'isbn', 'status', 'shelf_id', 'available'])
            ->fields([
                'title',
                'summary',
                'isbn',
                'status',
                'price',
                'shelf_id',
                'published_on',
                'available',
                'cover',
                'notes',
            ])
            ->showFields([
                'title',
                'summary',
                'isbn',
                'status',
                'price',
                'shelf_id',
                'published_on',
                'available',
                'cover',
                'notes',
                'created_by',
                'created_at',
                'updated_at',
            ])
            ->exportColumns([
                'title',
                'summary',
                'isbn',
                'status',
                'price',
                'shelf_id',
                'published_on',
                'available',
                'notes',
                'created_by',
            ])
            ->searchFields(['title', 'isbn'])
            ->filters(['status', 'shelf_id', 'available'])
            ->setRules([
                'isbn' => 'required|max_length[20]|is_unique[library_books.isbn,id,{id}]',
                'status' => 'permit_empty|in_list[available,lent,lost]',
                'price' => 'permit_empty|decimal',
                'shelf_id' => 'required|is_natural_no_zero',
                'published_on' => 'permit_empty|valid_date[Y-m-d]',
                'available' => 'permit_empty|in_list[0,1]',
                'cover' => 'permit_empty|max_length[200]',
                'notes' => 'permit_empty|max_length[65000]',
            ])
            ->setDefault('status', 'available')
            ->setDefault('available', '1')
            ->displayAs(self::labels())
            ->beforeInsert(fn (array $data): array|string => $this->beforeSave($data, [], $me))
            ->beforeUpdate(fn (array $data, string $id, array $old): array|string => $this->beforeSave($data, $old, $me))
            ->defaultOrder('id', 'desc');

        $crud->enableImport();

        // Record rule: without `library-books.all`, only the rows whose `created_by` is the user (list, show, edit, delete, bulk, export).
        if (! $this->can('library-books.all')) {
            $crud->where('created_by', $me);
        }

        // `price` exists only for users with `library-books.prices` (list, details, forms, search, export, forged posts).
        if (! $this->can('library-books.prices')) {
            $crud->hideFields(['price']);
        }

        // Custom operation `lend` (permission `library-books.lend`).
        $crud->addOperation('lend', static function (string $id, array $row): string {
            // TODO: what the operation does with the row.

            return lang('Library.books.ops.lend.done');
        }, [
            'label'      => lang('Library.books.ops.lend.label'),
            'icon'       => 'bi bi-box-arrow-right',
            'confirm'    => lang('Library.books.ops.lend.confirm'),
            'permission' => 'lend',
        ]);

        // Custom operation `writeoff` (permission `library-books.writeoff`), behind re-authentication.
        $crud->addOperation('writeoff', function (string $id, array $row): ResponseInterface|string {
            if (($response = $this->requireReauth()) !== null) {
                return $response;
            }

            // TODO: what the operation does with the row.

            return lang('Library.books.ops.writeoff.done');
        }, [
            'label'      => lang('Library.books.ops.writeoff.label'),
            'icon'       => 'bi bi-x-octagon',
            'permission' => 'writeoff',
        ]);

        return $this->renderCrud($crud);
    }

    /**
     * Sanitises the posted rich text with HTMLPurifier before kpcrudy reads the form
     * (plain fields and the translations in `kp_tr[<locale>][<field>]`).
     */
    private function sanitizePosted(): void
    {
        $post = $this->request->getPost();

        if ($post === []) {
            return;
        }

        foreach (['notes'] as $field) {
            if (array_key_exists($field, $post)) {
                $post[$field] = is_string($post[$field]) ? HtmlSanitizer::clean($post[$field]) : '';
            }
        }

        foreach (is_array($post['kp_tr'] ?? null) ? $post['kp_tr'] : [] as $locale => $fields) {
            foreach (['summary'] as $field) {
                if (is_array($fields) && array_key_exists($field, $fields)) {
                    $post['kp_tr'][$locale][$field] = is_string($fields[$field]) ? HtmlSanitizer::clean($fields[$field]) : '';
                }
            }
        }

        $this->request->setGlobal('post', $post);
    }

    /**
     * @return array<string, string>
     */
    private static function labels(): array
    {
        $labels = [];

        foreach ([
            'title',
            'summary',
            'isbn',
            'status',
            'price',
            'shelf_id',
            'published_on',
            'available',
            'cover',
            'notes',
            'created_by',
            'created_at',
            'updated_at',
        ] as $field) {
            $labels[$field] = lang('Library.books.fields.' . $field);
        }

        return $labels;
    }

    /**
     * Prepares the data of an insert (`$old` empty) or an update.
     *
     * @param array<string, mixed> $data
     * @param array<string, mixed> $old
     *
     * @return array<string, mixed>|string
     */
    private function beforeSave(array $data, array $old, int $me): array|string
    {
        if (array_key_exists('cover', $data)) {
            $current = is_string($old['cover'] ?? null) ? $old['cover'] : null;
            $data['cover'] = is_string($data['cover']) && trim($data['cover']) !== '' ? trim($data['cover']) : null;

            if (! BooksUploads::accepts('cover', $data['cover'], $current)) {
                return lang('Core.picker.errors.value');
            }
        }

        // A new row belongs to the user who adds it.
        if ($old === [] && ($data['created_by'] ?? null) === null) {
            $data['created_by'] = $me;
        }
        return $data;
    }

    /**
     * Translated options of a select: value => label.
     *
     * @param list<string> $values
     *
     * @return array<string, string>
     */
    private static function options(string $field, array $values): array
    {
        $options = [];

        foreach ($values as $value) {
            $options[$value] = lang('Library.books.options.' . $field . '.' . $value);
        }

        return $options;
    }
}
