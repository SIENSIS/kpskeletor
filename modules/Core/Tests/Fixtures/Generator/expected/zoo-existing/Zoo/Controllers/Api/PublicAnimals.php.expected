<?php

declare(strict_types=1);

namespace Modules\Zoo\Controllers\Api;

use CodeIgniter\Controller;
use CodeIgniter\HTTP\ResponseInterface;
use Kpapy\Resource;

/**
 * API resource `api/v1/public/zoo/animals` (kpapy): the public list of animals. Generated by the code generator
 * (docs/devtools.md).
 *
 * Public: no token (`kpapy:public`, GET routes only), no permission resolver, read only;
 * rate-limited per IP. Every row of the table is public: add a `where()` if some are not.
 */
final class PublicAnimals extends Controller
{
    public function index(): ResponseInterface
    {
        return (new Resource())
            ->setTable('zoo_animals')
            ->setBasePath('api/v1/public/zoo/animals')
            ->setResource('zoo-public-animals')
            ->setPermissionResolver(null)
            ->setPermission('list', true)
            ->setPermission('show', true)
            ->fieldType('species', 'enum', ['options' => ['cat' => 'cat', 'dog' => 'dog', 'bird' => 'bird']])
            ->fieldType('born_on', 'date')
            ->fields(['id', 'name', 'species', 'keeper_id', 'born_on', 'created_at', 'updated_at'])
            ->listFields(['id', 'name', 'species', 'keeper_id', 'born_on'])
            ->filters(['species', 'keeper_id'])
            ->searchFields(['name'])
            ->defaultOrder('id', 'desc')
            ->readOnly()
            ->unsetTrash()
            ->hideFields(['keeper_id'])
            ->describe(lang('Zoo.animals.api.summary'), lang('Zoo.animals.api.description'))
            ->render();
    }
}
