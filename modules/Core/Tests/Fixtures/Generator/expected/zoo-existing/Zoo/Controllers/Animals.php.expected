<?php

declare(strict_types=1);

namespace Modules\Zoo\Controllers;

use CodeIgniter\HTTP\ResponseInterface;
use Modules\Core\Controllers\BackendController;

/**
 * Back office of the animals, `<back office>/zoo/animals` (resource `zoo-animals`, table
 * `zoo_animals`). Generated by the code generator (docs/devtools.md); adapt it freely within the
 * rules of `CLAUDE.md`. Writes, operations and exports are logged by the Core (`AuditedCrud`).
 *
 * - Record rule: users without `zoo-animals.all` see and change only their rows (`keeper_id`).
 */
final class Animals extends BackendController
{
    public function index(): ResponseInterface|string
    {
        $crud = $this->crud('zoo-animals');
        $me   = (int) auth()->id();

        $crud->setTable('zoo_animals')
            ->setSubject(lang('Zoo.animals.singular'), lang('Zoo.animals.plural'))
            ->fieldType('species', 'select', ['options' => self::options('species', ['cat', 'dog', 'bird'])])
            ->setRelation('keeper_id', 'users', 'username')
            ->fieldType('born_on', 'date')
            ->columns(['name', 'species', 'keeper_id', 'born_on'])
            ->fields(['name', 'species', 'keeper_id', 'born_on'])
            ->showFields(['name', 'species', 'keeper_id', 'born_on', 'created_at', 'updated_at'])
            ->searchFields(['name'])
            ->filters(['species', 'keeper_id'])
            ->setRules([
                'name' => 'required|max_length[100]',
                'species' => 'required|in_list[cat,dog,bird]',
                'keeper_id' => 'permit_empty|is_natural_no_zero',
                'born_on' => 'permit_empty|valid_date[Y-m-d]',
            ])
            ->displayAs(self::labels())
            ->beforeInsert(fn (array $data): array => $this->beforeSave($data, [], $me))
            ->beforeUpdate(fn (array $data, string $id, array $old): array => $this->beforeSave($data, $old, $me))
            ->defaultOrder('id', 'desc');

        // Operations the resource does not declare (manifest `except`).
        $crud->unsetExport();

        // Plain ids in the URLs (masked ids are the default; they are not access control).
        $crud->maskIds(false);

        // Record rule: without `zoo-animals.all`, only the rows whose `keeper_id` is the user (list, show, edit, delete, bulk, export).
        if (! $this->can('zoo-animals.all')) {
            $crud->where('keeper_id', $me);
            $crud->hideFields(['keeper_id']);
        }

        return $this->renderCrud($crud);
    }

    /**
     * @return array<string, string>
     */
    private static function labels(): array
    {
        $labels = [];

        foreach (['name', 'species', 'keeper_id', 'born_on', 'created_at', 'updated_at'] as $field) {
            $labels[$field] = lang('Zoo.animals.fields.' . $field);
        }

        return $labels;
    }

    /**
     * Prepares the data of an insert (`$old` empty) or an update.
     *
     * @param array<string, mixed> $data
     * @param array<string, mixed> $old
     *
     * @return array<string, mixed>
     */
    private function beforeSave(array $data, array $old, int $me): array
    {
        // A new row belongs to the user who adds it.
        if ($old === [] && ($data['keeper_id'] ?? null) === null) {
            $data['keeper_id'] = $me;
        }
        return $data;
    }

    /**
     * Translated options of a select: value => label.
     *
     * @param list<string> $values
     *
     * @return array<string, string>
     */
    private static function options(string $field, array $values): array
    {
        $options = [];

        foreach ($values as $value) {
            $options[$value] = lang('Zoo.animals.options.' . $field . '.' . $value);
        }

        return $options;
    }
}
