<?php

declare(strict_types=1);

namespace Modules\Zoo\Tests;

use CodeIgniter\Shield\Entities\User;
use Kpcrudy\Crud;
use Modules\Auth\Tests\AuthTestCase;
use Modules\Core\Permissions\CrudPermissions;

/**
 * The CRUD `zoo-animals` (`<back office>/zoo/animals`, table `zoo_animals`): its permissions,
 * forged posts and its own rules. Generated by the code generator (docs/devtools.md): add the
 * tests of the rules you write.
 *
 * @internal
 */
final class AnimalsCrudTest extends AuthTestCase
{
    private const LIST = 'zoo/animals';

    protected function setUp(): void
    {
        parent::setUp();
        CrudPermissions::reset();
    }

    public function testTheListNeedsItsPermission(): void
    {
        $this->send('GET', backend_path(self::LIST))->assertRedirectTo(site_url('login'));

        $this->signIn();
        $this->send('GET', backend_path(self::LIST))->assertStatus(403);
    }

    public function testAUserWithTheListPermissionSeesTheRows(): void
    {
        $this->signIn('zoo-animals.list', 'zoo-animals.show');
        $this->row();

        $this->send('GET', backend_path(self::LIST))->assertOK();
    }

    public function testForgedPostsWithoutPermissionChangeNothing(): void
    {
        $this->signIn('zoo-animals.list', 'zoo-animals.show');
        $id   = $this->row();
        $rows = $this->db->table('zoo_animals')->countAllResults();
        $list = backend_path(self::LIST);

        $this->assertCrudRefused($this->send('POST', $list . '/add', $this->form()), $list, 'add');
        $this->assertCrudRefused($this->send('POST', $list . '/edit/' . $this->code($id), $this->form()), $list, 'edit');
        $this->assertCrudRefused($this->send('POST', $list . '/delete/' . $this->code($id)), $list, 'delete');

        $this->assertSame($rows, $this->db->table('zoo_animals')->countAllResults());
    }

    public function testAUserWithTheAddPermissionAddsARow(): void
    {
        $this->signIn('zoo-animals.list', 'zoo-animals.add');
        $rows = $this->db->table('zoo_animals')->countAllResults();

        $this->send('POST', backend_path(self::LIST) . '/add', $this->form())->assertRedirect();

        $this->assertSame($rows + 1, $this->db->table('zoo_animals')->countAllResults());
    }

    public function testWithoutAllAUserChangesOnlyTheirOwnRows(): void
    {
        $this->signIn('zoo-animals.list', 'zoo-animals.show', 'zoo-animals.edit');
        $other = $this->row(['keeper_id' => (int) $this->createUser('other@example.com', 'editor')->id]);

        // A row outside the user's scope is "not found".
        $this->send('POST', backend_path(self::LIST) . '/edit/' . $this->code($other), ['name' => 'Forged'] + $this->form());

        $this->assertNotSame('Forged', $this->db->table('zoo_animals')->where('id', $other)->get()->getRowArray()['name'] ?? null);
    }

    /**
     * A signed-in user of the `editor` group (no default grant on this resource) with these
     * individual permissions.
     */
    private function signIn(string ...$permissions): User
    {
        $user = $this->createUser('ana@example.com', 'editor');

        if ($permissions !== []) {
            $user->addPermission(...$permissions);
        }

        $this->login('ana@example.com');

        return $user;
    }

    /**
     * A row written directly (no CRUD) and owned by the signed-in user, returning its id.
     *
     * @param array<string, mixed> $values
     */
    private function row(array $values = []): int
    {
        $this->db->table('zoo_animals')->insert($values + ['keeper_id' => auth()->id()] + ['name' => 'Mar Escamilla', 'species' => 'cat']);

        return (int) $this->db->insertID();
    }

    /**
     * The values of the add/edit form.
     *
     * @return array<string, mixed>
     */
    private function form(): array
    {
        return ['name' => 'Mar Escamilla', 'species' => 'cat', 'keeper_id' => '', 'born_on' => '2026-04-21'];
    }

    private function code(int $id): string
    {
        return (string) $id;
    }
}
