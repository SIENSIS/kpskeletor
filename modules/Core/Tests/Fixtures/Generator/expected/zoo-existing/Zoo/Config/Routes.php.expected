<?php

declare(strict_types=1);

use CodeIgniter\Router\RouteCollection;

/**
 * Routes of the Zoo module (discovered by CodeIgniter). Every back-office route declares its
 * `can:` filter; the route name is "<module>-<resource>".
 *
 * @var RouteCollection $routes
 */
$routes->group(backend_path('zoo'), ['namespace' => 'Modules\Zoo\Controllers'], static function (RouteCollection $routes): void {
    $routes->get('/', 'Home::index', ['as' => 'zoo-main', 'filter' => 'can:zoo-main.view']);
});

\Modules\Core\Crud\CrudFactory::routes($routes, 'zoo-animals', backend_path('zoo/animals'), '\Modules\Zoo\Controllers\Animals::index');
$routes->get('api/v1/public/zoo/animals', '\Modules\Zoo\Controllers\Api\PublicAnimals::index', ['filter' => 'kpapy:public', 'kpapy' => true]);
$routes->get('api/v1/public/zoo/animals/(:any)', '\Modules\Zoo\Controllers\Api\PublicAnimals::index', ['filter' => 'kpapy:public']);
$routes->options('api/v1/public/zoo/animals', static fn () => service('response')->setStatusCode(204), ['filter' => 'kpapy:public']);
$routes->options('api/v1/public/zoo/animals/(:any)', static fn () => service('response')->setStatusCode(204), ['filter' => 'kpapy:public']);
