<?php

declare(strict_types=1);

namespace Modules\Notes\Controllers;

use Modules\Core\Controllers\BackendController;

/**
 * Main back-office screen of the Notes module (resource "main").
 */
final class Home extends BackendController
{
    public function index(): string
    {
        return $this->render('Modules\Notes\Views\index', [
            'title' => lang('Notes.title'),
        ]);
    }
}
