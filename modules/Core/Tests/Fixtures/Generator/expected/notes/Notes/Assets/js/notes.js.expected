/**
 * Example component of the Notes module: `data-component="notes/notes"` in
 * Views/index.php. core/components.js imports this file on demand (import map: `notes/…` =
 * modules/Notes/Assets/js/…) and calls mount(element, options). Build the DOM with
 * textContent/createElement, never innerHTML with data; import other modules with bare
 * specifiers (`core/http.js`, `notes/…`), never relative paths.
 */
export function mount(root, options) {
    root.textContent = String(options.message || '');
    root.hidden = false;
}
