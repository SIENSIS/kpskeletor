<?php

declare(strict_types=1);

namespace Modules\Notes\Controllers;

use CodeIgniter\HTTP\ResponseInterface;
use Modules\Core\Controllers\BackendController;

/**
 * Back office of the notes, `<back office>/notes/items` (resource `notes-items`, table
 * `notes_items`). Generated by the code generator (docs/devtools.md); adapt it freely within the
 * rules of `CLAUDE.md`. Writes, operations and exports are logged by the Core (`AuditedCrud`).
 */
final class Items extends BackendController
{
    public function index(): ResponseInterface|string
    {
        $crud = $this->crud('notes-items');

        $crud->setTable('notes_items')
            ->setSubject(lang('Notes.items.singular'), lang('Notes.items.plural'))
            ->fieldType('body', 'textarea')
            ->columns(['title'])
            ->fields(['title', 'body'])
            ->showFields(['title', 'body', 'created_at', 'updated_at'])
            ->exportColumns(['title', 'body'])
            ->searchFields(['title'])
            ->setRules(['title' => 'required|max_length[120]', 'body' => 'permit_empty|max_length[10000]'])
            ->displayAs(self::labels())
            ->defaultOrder('id', 'desc');

        $crud->enableImport();

        return $this->renderCrud($crud);
    }

    /**
     * @return array<string, string>
     */
    private static function labels(): array
    {
        $labels = [];

        foreach (['title', 'body', 'created_at', 'updated_at'] as $field) {
            $labels[$field] = lang('Notes.items.fields.' . $field);
        }

        return $labels;
    }
}
