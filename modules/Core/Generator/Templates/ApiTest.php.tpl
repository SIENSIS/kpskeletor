    public function testItNeedsAToken(): void
    {
        $this->api('GET', 'api/v1/{{path}}')->assertStatus(401);
    }

    public function testScopesNarrowTheToken(): void
    {
        $admin = $this->createUser('admin@example.com', 'admin');

        $this->api('GET', 'api/v1/{{path}}', null, $this->tokenFor($admin, ['{{resource}}.list']))->assertStatus(200);
        $this->api('POST', 'api/v1/{{path}}', ['forged' => '1'], $this->tokenFor($admin, ['{{resource}}.list']))->assertStatus(403);
